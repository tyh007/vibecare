# VibeCare client configuration.
#
# VITE_API_BASE_URL: where the React app sends its /api requests.
#   - In development, leave as /api so Vite proxies to the Hono server (port 8787).
#   - In production (Docker / static host), leave as /api so the bundled server
#     can serve both the API and the static client from one origin.
# Optional:
# VITE_MAPBOX_TOKEN: enables the location visualization on the Mood Dashboard.

VITE_API_BASE_URL=/api

# Optional: enables the location visualization in the mood dashboard.
VITE_MAPBOX_TOKEN=