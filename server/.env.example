# VibeCare API server configuration.
# Copy this file to .env (or .env.local) and fill in real values.
#
# All four are required at startup; the API refuses to start without them.

# Server bind port (also used by the Vite dev server's /api proxy).
PORT=8787

# HS256 signing secret for issued JWTs.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-32-bytes-of-random-base64

# Passphrase used to derive an AES-256-GCM key that encrypts per-user AI
# provider keys at rest. Must match the value used on first run; rotating it
# invalidates all stored AI keys.
# Generate with: openssl rand -base64 48
AI_KEY_PASSPHRASE=replace-me-too

# SQLite database file path. Relative to server/.
DB_PATH=./data/vibecare.db

# One of: trace, debug, info, warn, error.
LOG_LEVEL=info